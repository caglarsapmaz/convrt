# Convrt ortam değişkenleri — hepsi opsiyoneldir, güvenli varsayılanlar kullanılır.

# Maksimum yükleme boyutu (MB). Render dahil tüm ortamlarda güvenli varsayılan: 4.5
MAX_FILE_SIZE_MB=4.5

# IP başına basit istek limiti (kayar pencere). 0 = kapalı.
RATE_LIMIT_REQUESTS=30
# İstek limiti penceresi (saniye)
RATE_LIMIT_WINDOW=60

# Geçici dosya dizini (varsayılan: işletim sisteminin geçici dizini)
# CONVERT_TMP_DIR=/tmp/convrt
